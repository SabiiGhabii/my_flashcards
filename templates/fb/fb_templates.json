[
  {
    "id": "fb_concept_basic",
    "name": "Concept → Definition",
    "type": "fb",
    "description": "Term on front, crisp definition on back.",
    "placeholders": ["term", "definition", "tags"],
    "render": {
      "front": "What is [[term]]?",
      "back": "[[definition]]",
      "hint": "Recall the core idea and any assumptions.",
      "tag_rules": ["concept", "[[term]]"]
    }
  },
  {
    "id": "fb_concept_context",
    "name": "Concept with Context",
    "type": "fb",
    "description": "Definition plus 1-sentence context/use case.",
    "placeholders": ["term", "definition", "context", "tags"],
    "render": {
      "front": "[[term]] — define it.",
      "back": "[[definition]]\n\n_Context_: [[context]]",
      "hint": "Think: why/when is it used?",
      "tag_rules": ["concept", "[[term]]"]
    }
  },
